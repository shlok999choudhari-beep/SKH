model Assignment {
  id               Int       @id @default(autoincrement())
  courseId         Int       @map("course_id")
  moduleId         Int?      @map("module_id")
  trainerId        Int?      @map("trainer_id")
  title            String
  description      String? // Markdown / instructions
  dueDate          DateTime? @map("due_date")
  maxMarks         Float     @default(100) @map("max_marks")
  allowedFileTypes String?   @default("pdf,zip,docx,png") @map("allowed_file_types")
  maxFileSizeMb    Int       @default(10) @map("max_file_size_mb")
  submissionType   String    @default("file_upload") @map("submission_type") // file_upload, text_submission, both
  status           String    @default("draft") // draft, published
  orderIndex       Int       @default(0) @map("order_index")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module      CourseModule?          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  trainer     Trainer?               @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  submissions AssignmentSubmission[]
  progress    LearningProgress[]

  @@index([courseId])
  @@index([moduleId])
  @@index([trainerId])
  @@index([status])
  @@map("assignments")
}

model AssignmentSubmission {
  id           Int      @id @default(autoincrement())
  assignmentId Int      @map("assignment_id")
  studentId    Int      @map("student_id")
  status       String   @default("submitted") // submitted, late, graded, returned
  textAnswer   String?  @map("text_answer")
  fileUrl      String?  @map("file_url")
  fileName     String?  @map("file_name")
  fileSize     Int?     @map("file_size")
