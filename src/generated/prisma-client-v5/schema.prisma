// -------------------------------------------------------------
// PlaceIQ LMS (Learning Hub) Foundation Models
// -------------------------------------------------------------

model CourseCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now()) @map("created_at")

  courses Course[]

  @@map("course_categories")
}

model Course {
  id                    Int      @id @default(autoincrement())
  title                 String
  slug                  String?  @unique
  description           String?
  thumbnail             String?
  categoryId            Int?     @map("category_id")
  trainerId             Int?     @map("trainer_id")
  institutionId         Int?     @map("institution_id")
  difficulty            String   @default("Beginner") // Beginner, Intermediate, Advanced, All Levels
  estimatedDuration     String?  @map("estimated_duration")
  learningObjectives    String?  @map("learning_objectives")
  prerequisites         String?
  status                String   @default("draft") // draft, published, archived
  joinCode              String?  @unique @map("join_code")
  joinCodeEnabled       Boolean  @default(true) @map("join_code_enabled")
  thumbnailUrl          String?  @map("thumbnail_url")
  certificateEnabled    Boolean  @default(true) @map("certificate_enabled")
  requireAllLessons     Boolean  @default(true) @map("require_all_lessons")
  requireAllAssignments Boolean  @default(true) @map("require_all_assignments")
  requireAllQuizzes     Boolean  @default(true) @map("require_all_quizzes")
  minPassingGrade       Float    @default(60.0) @map("min_passing_grade")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")

  category         CourseCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  trainer          Trainer?               @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  institution      Institution?           @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  modules          CourseModule[]
  enrollments      CourseEnrollment[]
  assignments      Assignment[]
  quizzes          Quiz[]
  announcements    CourseAnnouncement[]
  discussions      CourseDiscussion[]
  completions      CourseCompletion[]
  certificates     Certificate[]
  knowledgeChunks  CourseKnowledgeChunk[]
  aiConversations  AIConversation[]
  studyPlans       StudyPlan[]
  learningInsights LearningInsight[]

  @@index([categoryId])
  @@index([trainerId])
  @@index([institutionId])
  @@index([status])
  @@map("courses")
}

model CourseModule {
  id          Int      @id @default(autoincrement())
  courseId    Int      @map("course_id")
  title       String
  description String?
  orderIndex  Int      @default(0) @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  course          Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons         CourseLesson[]
  resources       CourseResource[]
  assignments     Assignment[]
  quizzes         Quiz[]
  announcements   CourseAnnouncement[]
  discussions     CourseDiscussion[]
  knowledgeChunks CourseKnowledgeChunk[]
  aiConversations AIConversation[]

  @@index([courseId])
  @@index([orderIndex])
  @@map("course_modules")
}

model CourseLesson {
  id          Int      @id @default(autoincrement())
  moduleId    Int      @map("module_id")
  title       String
  description String?
  duration    String?
  orderIndex  Int      @default(0) @map("order_index")
  content     String?
  videoUrl    String?  @map("video_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  module          CourseModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources       CourseResource[]
  progress        LearningProgress[]
  knowledgeChunks CourseKnowledgeChunk[]
  aiConversations AIConversation[]

  @@index([moduleId])
  @@index([orderIndex])
  @@map("course_lessons")
}

model CourseResource {
  id         Int      @id @default(autoincrement())
  moduleId   Int?     @map("module_id")
  lessonId   Int?     @map("lesson_id")
  title      String
  type       String // PDF, VIDEO, DOCUMENT, EXTERNAL
  url        String
  fileSize   Int?     @map("file_size")
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  module   CourseModule?      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lesson   CourseLesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  progress LearningProgress[]

  @@index([moduleId])
  @@index([lessonId])
  @@map("course_resources")
}

model CourseEnrollment {
  id              Int       @id @default(autoincrement())
  courseId        Int       @map("course_id")
  studentId       Int       @map("student_id")
  status          String    @default("active") // active, completed, dropped
  progressPercent Float     @default(0) @map("progress_percent")
  enrolledAt      DateTime  @default(now()) @map("enrolled_at")
  completedAt     DateTime? @map("completed_at")
  lastAccessedAt  DateTime? @map("last_accessed_at")
  lastLessonId    Int?      @map("last_lesson_id")

  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student     Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  progress    LearningProgress[]
  completion  CourseCompletion?
  certificate Certificate?

  @@unique([courseId, studentId])
  @@index([courseId])
  @@index([studentId])
  @@index([status])
  @@map("course_enrollments")
}

model LearningProgress {
  id           Int       @id @default(autoincrement())
  enrollmentId Int       @map("enrollment_id")
  studentId    Int       @map("student_id")
  lessonId     Int?      @map("lesson_id")
  resourceId   Int?      @map("resource_id")
  assignmentId Int?      @map("assignment_id")
  quizId       Int?      @map("quiz_id")
  isCompleted  Boolean   @default(false) @map("is_completed")
  completedAt  DateTime? @map("completed_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  enrollment CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     CourseLesson?    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  resource   CourseResource?  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  assignment Assignment?      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  quiz       Quiz?            @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId, resourceId, assignmentId, quizId])
  @@index([studentId])
  @@index([enrollmentId])
  @@map("learning_progress")
}

