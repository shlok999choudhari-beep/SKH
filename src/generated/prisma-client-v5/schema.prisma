  explanation String?
  orderIndex  Int      @default(0) @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers QuizAnswer[]

  @@index([quizId])
  @@index([orderIndex])
  @@map("quiz_questions")
}

model QuizOption {
  id         Int     @id @default(autoincrement())
  questionId Int     @map("question_id")
  optionText String  @map("option_text")
  isCorrect  Boolean @default(false) @map("is_correct")
  orderIndex Int     @default(0) @map("order_index")

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([orderIndex])
  @@map("quiz_options")
}

model QuizAttempt {
  id               Int       @id @default(autoincrement())
  quizId           Int       @map("quiz_id")
  studentId        Int       @map("student_id")
  attemptNumber    Int       @default(1) @map("attempt_number")
  startedAt        DateTime  @default(now()) @map("started_at")
  submittedAt      DateTime? @map("submitted_at")
  timeTakenSeconds Int?      @map("time_taken_seconds")
  totalMarks       Float     @default(0) @map("total_marks")
  obtainedMarks    Float     @default(0) @map("obtained_marks")
  percentage       Float     @default(0)
  passed           Boolean   @default(false)
  status           String    @default("in_progress") // in_progress, completed, expired

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([quizId])
  @@index([studentId])
  @@index([status])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id                Int     @id @default(autoincrement())
  attemptId         Int     @map("attempt_id")
  questionId        Int     @map("question_id")
  selectedOptionIds String  @map("selected_option_ids") // JSON array of numbers e.g. "[1, 2]" or boolean string
  isCorrect         Boolean @default(false) @map("is_correct")
  awardedMarks      Float   @default(0) @map("awarded_marks")

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([questionId])
  @@map("quiz_answers")
}

// -------------------------------------------------------------
// PHASE 3: COLLABORATION & CERTIFICATION
// -------------------------------------------------------------

model CourseAnnouncement {
  id        Int      @id @default(autoincrement())
  courseId  Int      @map("course_id")
  moduleId  Int?     @map("module_id")
  authorId  Int      @map("author_id") // User ID
  trainerId Int?     @map("trainer_id") // Optional trainer record ID
  title     String
  content   String   @db.Text
  isPinned  Boolean  @default(false) @map("is_pinned")
  status    String   @default("published") // draft, published, archived
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  course  Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module  CourseModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  trainer Trainer?      @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([authorId])
  @@index([isPinned])
  @@index([status])
  @@map("course_announcements")
}

model CourseDiscussion {
  id           Int      @id @default(autoincrement())
  courseId     Int      @map("course_id")
  moduleId     Int?     @map("module_id")
  authorId     Int      @map("author_id") // User ID
  studentId    Int?     @map("student_id") // Student ID if author is student
  title        String
  content      String   @db.Text
  isPinned     Boolean  @default(false) @map("is_pinned")
  isLocked     Boolean  @default(false) @map("is_locked")
  helpfulCount Int      @default(0) @map("helpful_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  course  Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module  CourseModule?     @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  author  User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  student Student?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  replies DiscussionReply[]

  @@index([courseId])
  @@index([moduleId])
  @@index([authorId])
  @@index([isPinned])
  @@map("course_discussions")
}

model DiscussionReply {
  id           Int      @id @default(autoincrement())
  discussionId Int      @map("discussion_id")
  authorId     Int      @map("author_id") // User ID
  studentId    Int?     @map("student_id") // Student ID if author is student
  content      String   @db.Text
  isHelpful    Boolean  @default(false) @map("is_helpful")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  discussion CourseDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  author     User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  student    Student?         @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([discussionId])
  @@index([authorId])
  @@map("discussion_replies")
}

model CourseCompletion {
  id                   Int      @id @default(autoincrement())
  enrollmentId         Int      @unique @map("enrollment_id")
  courseId             Int      @map("course_id")
  studentId            Int      @map("student_id")
  completionPercentage Float    @default(100.0) @map("completion_percentage")
  finalScore           Float?   @map("final_score")
  lessonsCompleted     Int      @default(0) @map("lessons_completed")
  assignmentsCompleted Int      @default(0) @map("assignments_completed")
  quizzesPassed        Int      @default(0) @map("quizzes_passed")
  completedAt          DateTime @default(now()) @map("completed_at")
  createdAt            DateTime @default(now()) @map("created_at")

  enrollment CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([studentId])
  @@map("course_completions")
}

model Certificate {
  id                Int       @id @default(autoincrement())
  certificateId     String    @unique @map("certificate_id") // PIQ-CERT-XXXXXXXX
  verificationToken String    @unique @map("verification_token")
  enrollmentId      Int       @unique @map("enrollment_id")
  courseId          Int       @map("course_id")
  studentId         Int       @map("student_id")
  trainerId         Int?      @map("trainer_id")
  documentId        Int?      @unique @map("document_id") // Document Vault entry
  studentName       String    @map("student_name")
  courseTitle       String    @map("course_title")
  instructorName    String?   @map("instructor_name")
  institutionName   String?   @map("institution_name")
  issueDate         DateTime  @default(now()) @map("issue_date")
  status            String    @default("valid") // valid, revoked
  revokedAt         DateTime? @map("revoked_at")
  revokedReason     String?   @map("revoked_reason")
  qrCodeDataUrl     String?   @map("qr_code_data_url") @db.Text
  pdfUrl            String?   @map("pdf_url")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  enrollment CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  trainer    Trainer?         @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  document   Document?        @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([certificateId])
  @@index([verificationToken])
  @@index([courseId])
  @@index([studentId])
  @@index([trainerId])
  @@index([status])
  @@map("certificates")
}

// -------------------------------------------------------------
// PHASE 4: AI-POWERED LEARNING
// -------------------------------------------------------------

model CourseKnowledgeChunk {
  id         Int      @id @default(autoincrement())
  courseId   Int      @map("course_id")
  moduleId   Int?     @map("module_id")
  lessonId   Int?     @map("lesson_id")
  chunkIndex Int      @default(0) @map("chunk_index")
  title      String
  content    String   @db.Text
  sourceType String   @default("LESSON") @map("source_type") // LESSON, RESOURCE, SYLLABUS, TRAINER_NOTES
  sourceName String   @map("source_name")
  tokenCount Int      @default(0) @map("token_count")
  keywords   String?  @map("keywords")
  createdAt  DateTime @default(now()) @map("created_at")

  course Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module CourseModule? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lesson CourseLesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([moduleId])
  @@index([lessonId])
  @@index([sourceType])
  @@map("course_knowledge_chunks")
}

model AIConversation {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  studentId Int?     @map("student_id")
  courseId  Int      @map("course_id")
  moduleId  Int?     @map("module_id")
  lessonId  Int?     @map("lesson_id")
  title     String   @default("Course Discussion")
  summary   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user     User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  student  Student?      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module   CourseModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  lesson   CourseLesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  messages AIMessage[]

  @@index([userId])
  @@index([studentId])
  @@index([courseId])
  @@map("ai_conversations")
}

model AIMessage {
  id             Int      @id @default(autoincrement())
  conversationId Int      @map("conversation_id")
  sender         String // "user" | "assistant" | "system"
  content        String   @db.Text
  sources        String?  @db.Text // JSON string of [{ title, sourceType, sourceName }]
  tokensUsed     Int?     @map("tokens_used")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model StudyPlan {
  id             Int       @id @default(autoincrement())
  studentId      Int       @map("student_id")
  courseId       Int?      @map("course_id")
  title          String
  targetExamDate DateTime? @map("target_exam_date")
  dailyHours     Float     @default(1.5) @map("daily_hours")
  weeklySchedule String    @map("weekly_schedule") @db.Text // JSON array of day plans
  status         String    @default("active") // active, completed, archived
  generatedByAi  Boolean   @default(true) @map("generated_by_ai")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@map("study_plans")
}

model LearningInsight {
  id                 Int      @id @default(autoincrement())
  studentId          Int      @map("student_id")
  courseId           Int?     @map("course_id")
  strongTopics       String   @map("strong_topics") @db.Text // JSON array of strings
  weakTopics         String   @map("weak_topics") @db.Text // JSON array of { topic, status: "Needs Practice"|"Developing", reason }
  recommendedActions String   @map("recommended_actions") @db.Text // JSON array of action cards
  lastCalculatedAt   DateTime @default(now()) @map("last_calculated_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([courseId])
  @@map("learning_insights")
}

model AIUsage {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  studentId  Int?     @map("student_id")
  feature    String // assistant, quiz_gen, planner, feedback, summary, practice
  tokensUsed Int      @default(0) @map("tokens_used")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([feature])
  @@map("ai_usages")
}

model SkillProfile {
  id                 Int      @id @default(autoincrement())
  studentId          Int      @map("student_id")
  skillName          String   @map("skill_name")
  category           String? // Frontend, Backend, Data & AI, Cloud & DevOps, System Architecture, Core CS
  proficiencyPercent Float    @default(0) @map("proficiency_percent") // 0-100%
  level              String   @default("Beginner") // Beginner, Intermediate, Advanced, Expert
  verifiedStatus     String   @default("SYSTEM_DERIVED") @map("verified_status") // SYSTEM_DERIVED, AI_INFERRED, TRAINER_VERIFIED
  lastEvaluatedAt    DateTime @default(now()) @map("last_evaluated_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  student   Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  evidences SkillEvidence[]

  @@unique([studentId, skillName])
  @@index([studentId])
  @@index([skillName])
  @@index([verifiedStatus])
  @@map("skill_profiles")
}

model SkillEvidence {
  id               Int      @id @default(autoincrement())
  skillProfileId   Int      @map("skill_profile_id")
  studentId        Int      @map("student_id")
  sourceType       String   @map("source_type") // CERTIFICATE, QUIZ_SCORE, ASSIGNMENT_GRADE, COURSE_COMPLETION, TRAINER_ENDORSEMENT
  sourceId         Int?     @map("source_id")
  evidenceText     String   @map("evidence_text")
  confidenceScore  Float    @default(1.0) @map("confidence_score")
  verificationType String   @default("SYSTEM_DERIVED") @map("verification_type") // SYSTEM_DERIVED, AI_INFERRED, TRAINER_VERIFIED
  trainerId        Int?     @map("trainer_id")
  createdAt        DateTime @default(now()) @map("created_at")

  skillProfile SkillProfile @relation(fields: [skillProfileId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([skillProfileId])
  @@index([studentId])
  @@index([sourceType])
  @@map("skill_evidences")
}

model PlacementReadiness {
  id                     Int      @id @default(autoincrement())
  studentId              Int      @unique @map("student_id")
  overallScore           Float    @default(0) @map("overall_score") // 0-100%
  learningScore          Float    @default(0) @map("learning_score") // max 30
  skillsScore            Float    @default(0) @map("skills_score") // max 25
  certificationsScore    Float    @default(0) @map("certifications_score") // max 15
  experienceScore        Float    @default(0) @map("experience_score") // max 15
  profileScore           Float    @default(0) @map("profile_score") // max 15
  readinessTier          String   @default("Developing") @map("readiness_tier") // High, Moderate, Developing, Needs Attention
  skillGaps              String   @default("[]") @map("skill_gaps") @db.Text // JSON array of gaps & bridges
  recommendedActionItems String   @default("[]") @map("recommended_action_items") @db.Text // JSON array of 3-5 next steps
  lastCalculatedAt       DateTime @default(now()) @map("last_calculated_at")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([overallScore])
  @@index([readinessTier])
  @@map("placement_readiness")
}

model StudentRiskAssessment {
  id                     Int       @id @default(autoincrement())
  studentId              Int       @unique @map("student_id")
  riskLevel              String    @default("On Track") @map("risk_level") // Needs Attention, Moderate, Low, On Track
  signals                String    @default("[]") @map("signals") @db.Text // JSON array of strings
  suggestedActions       String    @default("[]") @map("suggested_actions") @db.Text // JSON array of strings
  lastActiveDate         DateTime? @map("last_active_date")
  missedAssignmentsCount Int       @default(0) @map("missed_assignments_count")
  failedQuizzesCount     Int       @default(0) @map("failed_quizzes_count")
  averageScore           Float?    @map("average_score")
  lastEvaluatedAt        DateTime  @default(now()) @map("last_evaluated_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([riskLevel])
  @@map("student_risk_assessments")
}
