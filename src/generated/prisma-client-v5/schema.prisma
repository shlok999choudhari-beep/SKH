  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
  @@map("assignment_submissions")
}

model AssignmentGrade {
  id           Int      @id @default(autoincrement())
  submissionId Int      @unique @map("submission_id")
  trainerId    Int?     @map("trainer_id")
  marks        Float
  feedback     String?
  status       String   @default("accepted") // accepted, returned_for_revision
  gradedAt     DateTime @default(now()) @map("graded_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  trainer    Trainer?             @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  @@index([trainerId])
  @@map("assignment_grades")
}

model Quiz {
  id                 Int      @id @default(autoincrement())
  courseId           Int      @map("course_id")
  moduleId           Int?     @map("module_id")
  trainerId          Int?     @map("trainer_id")
  title              String
  description        String?
  timeLimit          Int      @default(30) @map("time_limit") // In minutes (0 for no limit)
  maxAttempts        Int      @default(3) @map("max_attempts")
  passingScore       Float    @default(60) @map("passing_score") // Percentage e.g. 60%
  randomizeQuestions Boolean  @default(false) @map("randomize_questions")
  showResultsAfter   Boolean  @default(true) @map("show_results_after")
  status             String   @default("draft") // draft, published
  orderIndex         Int      @default(0) @map("order_index")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  course    Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module    CourseModule?      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
