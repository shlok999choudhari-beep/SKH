generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model applications {
  id           Int          @id @default(autoincrement())
  student_id   Int
  job_id       Int
  match_score  Float?
  status       String       @default("pending")
  applied_at   DateTime     @default(now())
  job_postings job_postings @relation(fields: [job_id], references: [id], onDelete: Cascade)
  students     students     @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([student_id, job_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_logs {
  id             Int           @id @default(autoincrement())
  institution_id Int?
  user_id        Int
  action         String
  resource       String
  details        String?
  created_at     DateTime      @default(now())
  institutions   institutions? @relation(fields: [institution_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model certifications {
  id              Int          @id @default(autoincrement())
  student_id      Int
  institution_id  Int
  name            String
  provider        String
  issue_date      DateTime
  credential_url  String?
  verified_status String       @default("pending")
  created_at      DateTime     @default(now())
  institutions    institutions @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  students        students     @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model coding_sessions {
  id            Int       @id @default(autoincrement())
  company_id    Int
  student_id    Int
  room_id       String    @unique
  status        String    @default("active")
  score         Int?
  feedback      String?
  code_snapshot String?
  language      String?
  started_at    DateTime  @default(now())
  ended_at      DateTime?
  companies     companies @relation(fields: [company_id], references: [id], onDelete: Cascade)
  students      students  @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model cohorts {
  id              Int          @id @default(autoincrement())
  institution_id  Int
  name            String
  description     String?
  graduation_year Int?
  created_at      DateTime     @default(now())
  institutions    institutions @relation(fields: [institution_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model companies {
  id               Int                @id @default(autoincrement())
  institution_id   Int?
  company_name     String
  email            String             @unique
  password         String
  industry         String?
  website          String?
  location         String?
  company_size     String?
  description      String?
  contact_person   String?
  phone            String?
  is_online        Int                @default(0)
  created_at       DateTime           @default(now())
  updated_at       DateTime           @default(now())
  coding_sessions  coding_sessions[]
  institutions     institutions?      @relation(fields: [institution_id], references: [id])
  internships      internships[]
  job_postings     job_postings[]
  placement_drives placement_drives[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model document_requests {
  id             Int          @id @default(autoincrement())
  institution_id Int
  student_id     Int
  title          String
  reason         String
  category       String?
  status         String       @default("PENDING")
  document_id    Int?
  requested_at   DateTime     @default(now())
  completed_at   DateTime?
  documents      documents?   @relation(fields: [document_id], references: [id])
  institutions   institutions @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  students       students     @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([institution_id])
  @@index([status])
  @@index([student_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model documents {
  id                    Int                 @id @default(autoincrement())
  student_id            Int
  institution_id        Int?
  file_name             String
  file_path             String
  file_type             String
  file_size             Int
  document_type         String
  category              String
  description           String?
  access_level          String              @default("PRIVATE")
  verification_status   String              @default("PENDING")
  quality_score         Float?
  quality_result        String?
  extracted_information String?
  expiry_date           DateTime?
  version               Int                 @default(1)
  parent_document_id    Int?
  rejection_reason      String?
  uploaded_at           DateTime            @default(now())
  updated_at            DateTime            @default(now())
  verified_at           DateTime?
  verified_by           Int?
  document_requests     document_requests[]
  institutions          institutions?       @relation(fields: [institution_id], references: [id])
  documents             documents?          @relation("documentsTodocuments", fields: [parent_document_id], references: [id])
  other_documents       documents[]         @relation("documentsTodocuments")
  students              students            @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([access_level])
  @@index([institution_id])
  @@index([student_id])
  @@index([verification_status])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model institutions {
  id                                                                            Int                              @id @default(autoincrement())
  name                                                                          String
  domain                                                                        String?                          @unique
  contact_email                                                                 String?
  created_at                                                                    DateTime                         @default(now())
  updated_at                                                                    DateTime                         @default(now())
  audit_logs                                                                    audit_logs[]
  certifications                                                                certifications[]
  cohorts                                                                       cohorts[]
  companies                                                                     companies[]
  document_requests                                                             document_requests[]
  documents                                                                     documents[]
  internships                                                                   internships[]
  placement_drives                                                              placement_drives[]
  resource_requests                                                             resource_requests[]
  resource_sharing_notifications                                                resource_sharing_notifications[]
  resources                                                                     resources[]
  sharing_agreements_sharing_agreements_owner_institution_idToinstitutions      sharing_agreements[]             @relation("sharing_agreements_owner_institution_idToinstitutions")
  sharing_agreements_sharing_agreements_requesting_institution_idToinstitutions sharing_agreements[]             @relation("sharing_agreements_requesting_institution_idToinstitutions")
  students                                                                      students[]
  trainers                                                                      trainers[]
  users                                                                         users[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model internship_applications {
  id            Int         @id @default(autoincrement())
  internship_id Int
  student_id    Int
  status        String      @default("pending")
  applied_at    DateTime    @default(now())
  internships   internships @relation(fields: [internship_id], references: [id], onDelete: Cascade)
  students      students    @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([internship_id, student_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model internships {
  id                      Int                       @id @default(autoincrement())
  institution_id          Int
  company_id              Int?
  title                   String
  description             String
  location                String?
  stipend                 String?
  duration                String?
  deadline                DateTime?
  status                  String                    @default("open")
  created_at              DateTime                  @default(now())
  min_cgpa                Float?
  min_tenth_marks         Float?
  min_twelfth_marks       Float?
  internship_applications internship_applications[]
  companies               companies?                @relation(fields: [company_id], references: [id])
  institutions            institutions              @relation(fields: [institution_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model job_postings {
  id              Int            @id @default(autoincrement())
  company_id      Int
  title           String
  description     String?
  required_skills String?
  location        String?
  job_type        String?
  salary_range    String?
  is_active       Int            @default(1)
  created_at      DateTime       @default(now())
  applications    applications[]
  companies       companies      @relation(fields: [company_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model placement_applications {
  id               Int               @id @default(autoincrement())
  drive_id         Int
  student_id       Int
  current_round_id Int?
  status           String            @default("applied")
  applied_at       DateTime          @default(now())
  placement_rounds placement_rounds? @relation(fields: [current_round_id], references: [id])
  placement_drives placement_drives  @relation(fields: [drive_id], references: [id], onDelete: Cascade)
  students         students          @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([drive_id, student_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model placement_drives {
  id                     Int                      @id @default(autoincrement())
  institution_id         Int
  company_id             Int?
  title                  String
  description            String
  eligibility_criteria   String?
  status                 String                   @default("upcoming")
  created_at             DateTime                 @default(now())
  placement_applications placement_applications[]
  companies              companies?               @relation(fields: [company_id], references: [id])
  institutions           institutions             @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  placement_rounds       placement_rounds[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model placement_rounds {
  id                     Int                      @id @default(autoincrement())
  drive_id               Int
  round_name             String
  start_time             DateTime?
  end_time               DateTime?
  status                 String                   @default("scheduled")
  placement_applications placement_applications[]
  placement_drives       placement_drives         @relation(fields: [drive_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model resource_bookings {
  id                Int       @id @default(autoincrement())
  resource_id       Int
  booked_by_user_id Int?
  purpose           String?
  start_time        DateTime
  end_time          DateTime
  status            String    @default("confirmed")
  created_at        DateTime  @default(now())
  student_id        Int?
  rejection_reason  String?
  users             users?    @relation(fields: [booked_by_user_id], references: [id], onDelete: Cascade)
  resources         resources @relation(fields: [resource_id], references: [id], onDelete: Cascade)
  students          students? @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model resource_requests {
  id                        Int                  @id @default(autoincrement())
  resource_id               Int
  requesting_institution_id Int
  purpose                   String
  requested_date            DateTime
  start_time                DateTime
  end_time                  DateTime
  student_count             Int
  additional_requirements   String?
  status                    String               @default("pending")
  rejection_reason          String?
  created_at                DateTime             @default(now())
  updated_at                DateTime             @default(now())
  institutions              institutions         @relation(fields: [requesting_institution_id], references: [id], onDelete: Cascade)
  resources                 resources            @relation(fields: [resource_id], references: [id], onDelete: Cascade)
  sharing_agreements        sharing_agreements[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model resource_sharing_notifications {
  id             Int          @id @default(autoincrement())
  institution_id Int
  message        String
  read           Boolean      @default(false)
  created_at     DateTime     @default(now())
  institutions   institutions @relation(fields: [institution_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model resources {
  id                    Int                  @id @default(autoincrement())
  institution_id        Int
  name                  String
  type                  String
  capacity              Int?
  status                String               @default("active")
  created_at            DateTime             @default(now())
  availability          String?
  category              String?
  description           String?
  facilities            String?
  location              String?
  sharing_enabled       Boolean              @default(false)
  available_to_students Boolean              @default(false)
  resource_bookings     resource_bookings[]
  resource_requests     resource_requests[]
  institutions          institutions         @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  sharing_agreements    sharing_agreements[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model resumes {
  id             Int      @id @default(autoincrement())
  student_id     Int
  filename       String
  ats_score      Float?
  created_at     DateTime @default(now())
  analysis_data  String?
  extracted_text String?
  file_path      String?
  overall_rating Float?
  students       students @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model sharing_agreements {
  id                                                                      Int               @id @default(autoincrement())
  resource_id                                                             Int
  owner_institution_id                                                    Int
  requesting_institution_id                                               Int
  request_id                                                              Int
  start_date                                                              DateTime
  end_date                                                                DateTime
  status                                                                  String            @default("active")
  created_at                                                              DateTime          @default(now())
  updated_at                                                              DateTime          @default(now())
  institutions_sharing_agreements_owner_institution_idToinstitutions      institutions      @relation("sharing_agreements_owner_institution_idToinstitutions", fields: [owner_institution_id], references: [id], onDelete: Cascade)
  resource_requests                                                       resource_requests @relation(fields: [request_id], references: [id], onDelete: Cascade)
  institutions_sharing_agreements_requesting_institution_idToinstitutions institutions      @relation("sharing_agreements_requesting_institution_idToinstitutions", fields: [requesting_institution_id], references: [id], onDelete: Cascade)
  resources                                                               resources         @relation(fields: [resource_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model skill_assessments {
  id                Int      @id @default(autoincrement())
  student_id        Int
  skill_name        String
  proficiency_level Int?
  verified          Int      @default(0)
  created_at        DateTime @default(now())
  students          students @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model skill_gap_analyses {
  id            Int      @id @default(autoincrement())
  student_id    Int
  resume_name   String
  job_desc_name String
  analysis_data String
  created_at    DateTime @default(now())
  students      students @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model students {
  id                      Int                       @id @default(autoincrement())
  institution_id          Int?
  name                    String
  email                   String                    @unique
  password                String
  college                 String?
  degree                  String?
  graduation_year         Int?
  phone                   String?
  github_url              String?
  linkedin_url            String?
  portfolio_url           String?
  created_at              DateTime                  @default(now())
  updated_at              DateTime                  @default(now())
  cgpa                    Float?
  tenth_marks             Float?
  twelfth_marks           Float?
  applications            applications[]
  certifications          certifications[]
  coding_sessions         coding_sessions[]
  document_requests       document_requests[]
  documents               documents[]
  internship_applications internship_applications[]
  placement_applications  placement_applications[]
  resource_bookings       resource_bookings[]
  resumes                 resumes[]
  skill_assessments       skill_assessments[]
  skill_gap_analyses      skill_gap_analyses[]
  institutions            institutions?             @relation(fields: [institution_id], references: [id])
  trainer_sessions        trainer_sessions[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model trainer_sessions {
  id         Int       @id @default(autoincrement())
  trainer_id Int
  student_id Int?
  start_time DateTime
  end_time   DateTime
  status     String    @default("scheduled")
  notes      String?
  created_at DateTime  @default(now())
  students   students? @relation(fields: [student_id], references: [id])
  trainers   trainers  @relation(fields: [trainer_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model trainers {
  id               Int                @id @default(autoincrement())
  user_id          Int
  institution_id   Int
  expertise_tags   String?
  rating           Float              @default(0)
  created_at       DateTime           @default(now())
  subjects         String?
  bio              String?
  trainer_sessions trainer_sessions[]
  institutions     institutions       @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  users            users              @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                Int                 @id @default(autoincrement())
  institution_id    Int?
  name              String
  email             String              @unique
  password          String
  role              String
  status            String              @default("active")
  created_at        DateTime            @default(now())
  updated_at        DateTime            @default(now())
  resource_bookings resource_bookings[]
  trainers          trainers[]
  institutions      institutions?       @relation(fields: [institution_id], references: [id], onDelete: Cascade)
}
